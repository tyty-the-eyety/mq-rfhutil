                  </widget>
                </item>
                <item>
                  <widget class="QCheckBox" name="inclUsrCheck">
                    <property name="toolTip"><string>Include usr folder</string></property>
                    <property name="text"><string>usr</string></property>
                  </widget>
                </item>
                <item>
                  <widget class="QCheckBox" name="inclPsCheck">
                    <property name="toolTip"><string>Include psc (pub/sub command) folder</string></property>
                    <property name="text"><string>psc</string></property>
                  </widget>
                </item>
                <item>
                  <widget class="QCheckBox" name="inclPscrCheck">
                    <property name="toolTip"><string>Include pscr (pub/sub create response) folder</string></property>
                    <property name="text"><string>pscr</string></property>
                  </widget>
                </item>
                <item>
                  <widget class="QCheckBox" name="inclOtherCheck">
                    <property name="toolTip"><string>Include unrecognized folders (other)</string></property>
                    <property name="text"><string>other</string></property>
                  </widget>
                </item>
                <item>
                  <widget class="QCheckBox" name="v1InclPubsubCheck">
                    <property name="toolTip"><string>RFH v1: include pubsub name-value block</string></property>
                    <property name="text"><string>v1 pubsub</string></property>
                  </widget>
                </item>
                <item>
                  <widget class="QCheckBox" name="v1InclPscrCheck">
                    <property name="toolTip"><string>RFH v1: include pscr name-value block</string></property>
                    <property name="text"><string>v1 pscr</string></property>
                  </widget>
                </item>
              </layout>
            </widget>
          </item>
          <item>
            <spacer name="rightVSpacer">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0">
                <size><width>20</width><height>40</height></size>
