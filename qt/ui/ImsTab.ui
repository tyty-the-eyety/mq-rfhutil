<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
  <class>ImsTab</class>
  <widget class="QWidget" name="ImsTab">
    <property name="windowTitle"><string>IMS</string></property>
    <layout class="QVBoxLayout" name="rootLayout">
      <item>
        <layout class="QHBoxLayout" name="topRow">
          <item>
            <widget class="QCheckBox" name="includedCheck">
              <property name="toolTip"><string>Include the MQIIH IMS header</string></property>
              <property name="text"><string>Include IMS header</string></property>
