                </widget>
              </item>
              <item row="4" column="1">
                <widget class="QLineEdit" name="formatEdit">
                  <property name="toolTip"><string>Format of data following this header (8 chars)</string></property>
                  <property name="maxLength"><number>8</number></property>
                </widget>
              </item>
              <item row="5" column="0">
                <widget class="QLabel" name="flagsLabel">
                  <property name="text"><string>Flags</string></property>
                  <property name="buddy"><cstring>flagsEdit</cstring></property>
