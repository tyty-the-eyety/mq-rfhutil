              <property name="sizeHint" stdset="0">
                <size><width>40</width><height>20</height></size>
              </property>
            </spacer>
          </item>
        </layout>
      </item>
      <item>
        <layout class="QHBoxLayout" name="columnsLayout" stretch="1,1">
          <item>
            <layout class="QFormLayout" name="leftForm">
              <item row="0" column="0">
                <widget class="QLabel" name="ccsidLabel">
                  <property name="text"><string>CCSID</string></property>
