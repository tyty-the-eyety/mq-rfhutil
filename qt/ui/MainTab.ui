                    <item>
                      <widget class="QCheckBox" name="setAllCheck">
                        <property name="text"><string>Set All Context</string></property>
                        <property name="toolTip"><string>Set all MQMD context fields when writing to queue</string></property>
                        <property name="accessibleName"><string>Set All Context</string></property>
                      </widget>
                    </item>
                  </layout>
                </item>
                <item>
                  <layout class="QVBoxLayout" name="putGetRight">
                    <item>
                      <widget class="QCheckBox" name="newCorrelIdCheck">
                        <property name="text"><string>New Correl Id</string></property>
                        <property name="toolTip"><string>Create new correlation id when putting a message</string></property>
                        <property name="accessibleName"><string>New Correl Id</string></property>
                      </widget>
                    </item>
                    <item>
                      <widget class="QCheckBox" name="logicalOrderCheck">
                        <property name="text"><string>Logical Order</string></property>
                        <property name="toolTip"><string>Maintain logical order within group or segment</string></property>
                        <property name="accessibleName"><string>Logical Order</string></property>
                      </widget>
                    </item>
                    <item>
                      <widget class="QCheckBox" name="completeMsgCheck">
                        <property name="text"><string>Complete Msg</string></property>
                        <property name="toolTip"><string>Assemble any message segments into a single logical message</string></property>
                        <property name="accessibleName"><string>Complete Msg</string></property>
                      </widget>
                    </item>
                    <item>
                      <widget class="QCheckBox" name="allAvailCheck">
                        <property name="text"><string>All Avail</string></property>
                        <property name="toolTip"><string>All segments and msgs in group must be available</string></property>
                        <property name="accessibleName"><string>All Avail</string></property>
                      </widget>
                    </item>
                    <item>
                      <widget class="QCheckBox" name="convertCheck">
                        <property name="text"><string>Convert</string></property>
                        <property name="toolTip"><string>Use convert option on read and browse operations</string></property>
                        <property name="accessibleName"><string>Convert</string></property>
                      </widget>
                    </item>
                    <item>
                      <widget class="QCheckBox" name="alternateUserCheck">
                        <property name="text"><string>Alternate User Id</string></property>
                        <property name="toolTip"><string>Use alternate userid in MQMD user id field</string></property>
                        <property name="accessibleName"><string>Alternate User Id</string></property>
                      </widget>
                    </item>
                  </layout>
                </item>
              </layout>
            </widget>
          </item>
          <item>
            <spacer name="spacer4"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property></spacer>
          </item>
          <item>
            <layout class="QHBoxLayout" name="exitRow">
              <item>
                <spacer name="spacer5"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property></spacer>
              </item>
              <item>
                <widget class="QPushButton" name="exitButton">
                  <property name="text"><string>Exit</string></property>
                  <property name="toolTip"><string>Exit from the program</string></property>
                  <property name="accessibleName"><string>Exit</string></property>
                </widget>
              </item>
            </layout>
          </item>
        </layout>
      </item>
    </layout>
  </widget>
