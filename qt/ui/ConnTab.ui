<ui version="4.0">
  <class>ConnTab</class>
  <widget class="QWidget" name="ConnTab">
    <property name="windowTitle"><string>Conn</string></property>
    <layout class="QVBoxLayout" name="rootLayout">
      <item>
        <layout class="QHBoxLayout" name="columnsLayout" stretch="1,1">
          <item>
            <layout class="QFormLayout" name="leftForm">
              <item row="0" column="0">
                <widget class="QLabel" name="heartbeatLabel">
