                <widget class="QLabel" name="keyRepositoryLabel">
                  <property name="text"><string>Key Repository</string></property>
                  <property name="buddy"><cstring>keyRepositoryEdit</cstring></property>
                </widget>
              </item>
              <item row="0" column="1">
                <widget class="QLineEdit" name="keyRepositoryEdit">
                  <property name="toolTip"><string>Path to the SSL key repository (MQSCO.KeyRepository)</string></property>
                  <property name="maxLength"><number>256</number></property>
                </widget>
              </item>
              <item row="1" column="0">
                <widget class="QLabel" name="sslPeerNameLabel">
                  <property name="text"><string>SSL Peer Name</string></property>
                  <property name="buddy"><cstring>sslPeerNameEdit</cstring></property>
                </widget>
              </item>
              <item row="1" column="1">
                <widget class="QLineEdit" name="sslPeerNameEdit">
                  <property name="toolTip"><string>SSL peer name pattern for certificate verification (MQCD.SSLPeerNamePtr)</string></property>
                  <property name="maxLength"><number>1024</number></property>
