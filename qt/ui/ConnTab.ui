                </widget>
              </item>
              <item row="2" column="0">
                <widget class="QLabel" name="cipherSpecLabel">
                  <property name="text"><string>Cipher Spec</string></property>
                  <property name="buddy"><cstring>cipherSpecEdit</cstring></property>
                </widget>
              </item>
              <item row="2" column="1">
                <widget class="QLineEdit" name="cipherSpecEdit">
                  <property name="toolTip"><string>SSL/TLS cipher specification (MQCD.SSLCipherSpec, 32 chars max)</string></property>
                  <property name="maxLength"><number>32</number></property>
                </widget>
              </item>
            </layout>
          </item>
          <item>
            <layout class="QFormLayout" name="rightForm">
