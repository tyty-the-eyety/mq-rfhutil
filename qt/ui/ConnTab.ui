                  <property name="buddy"><cstring>heartbeatSpin</cstring></property>
                </widget>
              </item>
              <item row="0" column="1">
                <widget class="QSpinBox" name="heartbeatSpin">
                  <property name="toolTip"><string>Client channel heartbeat interval in seconds (0 = disabled)</string></property>
                  <property name="minimum"><number>0</number></property>
                  <property name="maximum"><number>999999</number></property>
                  <property name="value"><number>60</number></property>
