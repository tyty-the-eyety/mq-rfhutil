              </item>
              <item row="2" column="0">
                <widget class="QLabel" name="sslResetCountLabel">
                  <property name="text"><string>SSL Reset Count</string></property>
                  <property name="buddy"><cstring>sslResetCountSpin</cstring></property>
                </widget>
              </item>
              <item row="2" column="1">
                <widget class="QSpinBox" name="sslResetCountSpin">
                  <property name="toolTip"><string>Number of bytes to send before resetting the SSL secret key (0 = no reset)</string></property>
                  <property name="minimum"><number>0</number></property>
                  <property name="maximum"><number>999999999</number></property>
                  <property name="value"><number>0</number></property>
                </widget>
              </item>
            </layout>
          </item>
        </layout>
